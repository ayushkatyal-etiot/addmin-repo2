# Docker environment — postgres service runs at postgres:5432 (container hostname)
DATABASE_URL=postgresql://addmin:addmin@postgres:5432/addmin_dev
# For local connection outside Docker, use port 5433
# DATABASE_URL_LOCAL=postgresql://addmin:addmin@localhost:5433/addmin_dev
API_PORT=3001
NODE_ENV=development
SESSION_SECRET=dev-secret-change-in-production-immediately
WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
