# Copy this file to .env (never commit the real .env) and fill in real values
# for local development. In CI/staging, these are injected as secrets/env vars
# by the hosting provider — never hard-coded in the repo.

# --- Database (packages/db, apps/api) ---
# Postgres connection string used by Prisma.
DATABASE_URL=postgresql://addmin:addmin@localhost:5432/addmin_dev

# --- apps/api ---
# Port the NestJS API listens on.
API_PORT=3001
# Node environment: development | staging | production
NODE_ENV=development
# Secret used to sign/encrypt sessions (Step 03 uses this; generate a long random value).
SESSION_SECRET=change-me-in-every-environment

# --- apps/web ---
# Base URL the Next.js app uses to call the API.
NEXT_PUBLIC_API_URL=http://localhost:3001
